<Project Sdk="Meziantou.NET.Sdk.Razor">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Version>0.9.3</Version>
    <PackAsTool>true</PackAsTool>
    <PackageId>Meziantou.DocumentationGenerator</PackageId>
    <RootNamespace>Meziantou.DocumentationGenerator</RootNamespace>
    <Description>Generate a fully static documentation site from NuGet packages and Markdown pages.</Description>
    <PackageTags>documentation;docfx;api-reference;static-site;nuget</PackageTags>
    <SearchReadmeFileAbove>true</SearchReadmeFileAbove>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\**\*" LogicalName="assets/%(RecursiveDir)%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\schema\docgen.schema.json" Pack="true" PackagePath="schema\" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Meziantou.DocumentationGenerator.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Meziantou.Framework.FullPath" />
    <PackageReference Include="Meziantou.Framework.HtmlSanitizer" />
    <PackageReference Include="Meziantou.Framework.Markdown" />
    <PackageReference Include="Meziantou.Framework.PublicApiGenerator" />
    <PackageReference Include="Meziantou.Framework.SyntaxHighlighting" />
    <PackageReference Include="Meziantou.Framework.WebPlatform" />
    <PackageReference Include="Meziantou.Framework.Yaml" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="NuGet.Credentials" />
    <PackageReference Include="NuGet.Packaging" />
    <PackageReference Include="NuGet.Protocol" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>
</Project>
