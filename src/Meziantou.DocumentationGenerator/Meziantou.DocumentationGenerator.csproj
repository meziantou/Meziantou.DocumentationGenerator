<Project Sdk="Meziantou.NET.Sdk.Razor">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Version>0.1.0</Version>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>meziantou-docgen</ToolCommandName>
    <PackageId>Meziantou.DocumentationGenerator</PackageId>
    <!-- The assembly name is used as the command name in the help output -->
    <AssemblyName>meziantou-docgen</AssemblyName>
    <RootNamespace>Meziantou.DocumentationGenerator</RootNamespace>
    <Description>Generate a fully static documentation site from NuGet packages and Markdown pages.</Description>
    <PackageTags>documentation;docfx;api-reference;static-site;nuget</PackageTags>
    <SearchReadmeFileAbove>true</SearchReadmeFileAbove>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Meziantou.DocumentationGenerator.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>
</Project>
