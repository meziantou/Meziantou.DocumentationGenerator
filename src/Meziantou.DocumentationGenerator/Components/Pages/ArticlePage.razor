@inject SiteRenderContext Site
<SiteLayout Title="@Page.Title" Description="@Page.Rendered?.Description" PagePath="@PagePath" Headings="@Headings">
    <article class="article">
        <h1>@Page.Title</h1>
        @((MarkupString)(Page.Rendered?.Html ?? ""))
    </article>
</SiteLayout>

@code {
    [Parameter, EditorRequired]
    public required string PagePath { get; set; }

    private AuthoredPage Page => Site.Content.Pages.Single(p => p.Route.FilePath == PagePath);

    private IReadOnlyList<PageHeading> Headings => Page.Rendered is { } rendered ? [.. rendered.Headings.Select(h => new PageHeading(h.Level, h.Id, h.Text))] : [];
}
