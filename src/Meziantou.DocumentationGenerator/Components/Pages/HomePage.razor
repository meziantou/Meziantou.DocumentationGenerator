@inject SiteRenderContext Site
<SiteLayout Title="@Site.SiteTitle" Description="@Site.Configuration.Site.Description" PagePath="@LinkService.HomePath">
    <h1>@Site.SiteTitle</h1>
    @if (!string.IsNullOrEmpty(Site.Configuration.Site.Description))
    {
        <p class="lead">@Site.Configuration.Site.Description</p>
    }
    @if (Sections.Count == 0)
    {
        <p>This site has no page.</p>
    }
    else
    {
        <ul class="product-catalog">
            @foreach (var (title, url, description) in Sections)
            {
                <li class="product-card">
                    <h2><a href="@url">@title</a></h2>
                    @if (description is not null)
                    {
                        <p>@description</p>
                    }
                </li>
            }
        </ul>
    }
</SiteLayout>

@code {
    /// <summary>Top-level folders and pages of the content directory, in name order. Folders link to their first page.</summary>
    private IReadOnlyList<(string Title, string Url, string? Description)> Sections
    {
        get
        {
            var result = new List<(string, string, string?)>();
            foreach (var entry in Site.Content.Root?.Entries ?? [])
            {
                switch (entry)
                {
                    case AuthoredPage page:
                        result.Add((page.Title, page.Url, page.Description));
                        break;
                    case ContentFolder { FirstPage: { } first } folder:
                        result.Add((folder.Title, first.Url, folder.Description));
                        break;
                }
            }

            return result;
        }
    }
}
