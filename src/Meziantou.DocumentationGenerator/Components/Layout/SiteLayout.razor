@inject SiteRenderContext Site
<!DOCTYPE html>
<html lang="@Site.Configuration.Site.Language">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    @* Applies the stored theme before the first paint to avoid a flash of the wrong theme *@
    @((MarkupString)ThemeBootstrapScript)
    <title>@Site.GetDocumentTitle(Title)</title>
    @if (!string.IsNullOrEmpty(Description))
    {
        <meta name="description" content="@Description">
    }
    @if (Metadata.RobotsNoIndex)
    {
        <meta name="robots" content="noindex">
    }
    @if (Metadata.CanonicalUrl is not null)
    {
        <link rel="canonical" href="@Metadata.CanonicalUrl">
    }
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="@Site.SiteTitle">
    <meta property="og:title" content="@Title">
    @if (!string.IsNullOrEmpty(Description))
    {
        <meta property="og:description" content="@Description">
    }
    @if (Metadata.CanonicalUrl is not null)
    {
        <meta property="og:url" content="@Metadata.CanonicalUrl">
    }
    @if (Metadata.SocialImageUrl is not null)
    {
        <meta property="og:image" content="@Metadata.SocialImageUrl">
        <meta name="twitter:card" content="summary_large_image">
    }
    else
    {
        <meta name="twitter:card" content="summary">
    }
    @if (Site.FaviconUrl is not null)
    {
        <link rel="icon" href="@Site.FaviconUrl">
    }
    <link rel="stylesheet" href="@Site.Links.GetAssetUrl("site.css")">
    @HeadContent
</head>
<body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <header class="site-header">
        @if (!Navigation.Sidebar.IsEmpty)
        {
            <button type="button" class="menu-button" aria-controls="sidebar" aria-expanded="false" hidden>Table of contents</button>
        }
        <a class="site-title" href="@Site.Links.HomeUrl">
            @if (Site.LogoUrl is not null)
            {
                <img class="site-logo" src="@Site.LogoUrl" alt="" width="28" height="28">
            }
            @Site.SiteTitle
        </a>
        <div class="search" data-search hidden data-base-path="@Site.Links.Urls.BasePath.Value" data-index="@Site.Links.GetAssetUrl(Search.SearchIndexBuilder.FileName)">
            <form role="search" class="search-form">
                <label for="search-input" class="visually-hidden">Search the documentation</label>
                <input id="search-input" type="search" placeholder="Search" autocomplete="off" spellcheck="false" role="combobox" aria-expanded="false" aria-controls="search-results" aria-autocomplete="list" aria-describedby="search-status">
            </form>
            <ul id="search-results" class="search-results" role="listbox" aria-label="Search results" hidden></ul>
            <p id="search-status" class="search-status" role="status" aria-live="polite"></p>
        </div>
        <div class="header-tools">
            <div class="theme-picker" data-theme-picker hidden>
                <label for="theme-select">Theme</label>
                <select id="theme-select">
                    <option value="system">System</option>
                    <option value="light">Light</option>
                    <option value="dark">Dark</option>
                </select>
            </div>
        </div>
    </header>
    <div class="site-body">
        @if (!Navigation.Sidebar.IsEmpty)
        {
            <div class="sidebar-panel">
                <div class="sidebar-tools">
                    <button type="button" class="sidebar-collapse-button" aria-controls="sidebar" aria-expanded="true" aria-label="Collapse table of contents" title="Collapse table of contents" hidden>
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                            <rect x="3" y="4" width="18" height="16" rx="2" />
                            <path d="M9 4v16" />
                            <path class="sidebar-collapse-arrow" d="m16 9-3 3 3 3" />
                        </svg>
                    </button>
                </div>
                <nav class="sidebar" id="sidebar" aria-label="Table of contents">
                    @RenderTree(Navigation.Sidebar)
                </nav>
            </div>
        }
        <main id="main" class="content" tabindex="-1">
            @if (TargetFrameworks is { Count: > 1 })
            {
                <div class="tfm-filter" hidden data-tfm-filter>
                    <label>Target framework <select data-tfm-options="@string.Join(' ', TargetFrameworks)"></select></label>
                </div>
            }
            @if (!Navigation.Breadcrumbs.IsEmpty)
            {
                <nav class="breadcrumbs" aria-label="Breadcrumb">
                    <ol>
                        @foreach (var node in Navigation.Breadcrumbs)
                        {
                            <li>@if (node.Url is not null) { <a href="@node.Url">@node.Title</a> } else { <span>@node.Title</span> }</li>
                        }
                    </ol>
                </nav>
            }
            @ChildContent
            @if (Navigation.Previous is not null || Navigation.Next is not null)
            {
                <nav class="pager" aria-label="Previous and next articles">
                    @if (Navigation.Previous is { } previous)
                    {
                        <a class="pager-previous" rel="prev" href="@previous.Url"><span class="pager-label">Previous</span> @previous.Title</a>
                    }
                    @if (Navigation.Next is { } next)
                    {
                        <a class="pager-next" rel="next" href="@next.Url"><span class="pager-label">Next</span> @next.Title</a>
                    }
                </nav>
            }
        </main>
        @if (Headings is { Count: > 0 })
        {
            <aside class="page-toc" aria-labelledby="page-toc-title">
                <h2 id="page-toc-title">On this page</h2>
                <ul>
                    @foreach (var heading in Headings)
                    {
                        <li class="level-@heading.Level"><a href="#@UrlBuilder.EncodeFragment(heading.Id)">@heading.Text</a></li>
                    }
                </ul>
            </aside>
        }
    </div>
    <footer class="site-footer">
        @if (!string.IsNullOrEmpty(Site.Configuration.Site.Footer))
        {
            <p>@Site.Configuration.Site.Footer</p>
        }
    </footer>
    <div id="live-status" class="visually-hidden" role="status" aria-live="polite"></div>
    <script src="@Site.Links.GetAssetUrl("site.js")" defer></script>
    <script src="@Site.Links.GetAssetUrl("search.js")" defer></script>
</body>
</html>

@code {
    private const string ThemeBootstrapScript = "<script>document.documentElement.classList.add('js');try{var t=localStorage.getItem('docgen-theme');if(t==='light'||t==='dark')document.documentElement.setAttribute('data-theme',t)}catch(e){}</script>";

    [Parameter, EditorRequired]
    public required string Title { get; set; }

    [Parameter]
    public string? Description { get; set; }

    /// <summary>Output path of the page, used to mark the current page in navigation.</summary>
    [Parameter, EditorRequired]
    public required string PagePath { get; set; }

    [Parameter]
    public IReadOnlyList<PageHeading>? Headings { get; set; }

    /// <summary>The 404 page is not indexed and has no canonical URL, because it is served for any missing URL.</summary>
    [Parameter]
    public bool IsNotFound { get; set; }

    /// <summary>Target frameworks of the page, used by the optional client-side filter. Every variant is visible without JavaScript.</summary>
    [Parameter]
    public IReadOnlyList<string>? TargetFrameworks { get; set; }

    [Parameter]
    public RenderFragment? HeadContent { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private PageNavigation Navigation { get; set; } = PageNavigation.Empty;

    private (string? CanonicalUrl, string? SocialImageUrl, bool RobotsNoIndex) Metadata { get; set; }

    protected override void OnParametersSet()
    {
        Navigation = Site.Navigation.GetPageNavigation(PagePath);
        var siteUrl = Site.Configuration.Site.SiteUrl;
        Metadata = (
            IsNotFound ? null : UrlBuilder.GetAbsoluteUrl(siteUrl, Site.Links.Urls.GetUrl(PagePath)),
            Site.SocialImageUrl is null ? null : UrlBuilder.GetAbsoluteUrl(siteUrl, Site.SocialImageUrl),
            IsNotFound || Site.Configuration.Site.Robots is RobotsPolicy.Disallow);
    }

    private RenderFragment RenderTree(System.Collections.Immutable.ImmutableArray<NavigationNode> nodes) => @<ul>
        @foreach (var node in nodes)
        {
            @* Only the types of the current namespace are listed, so pages of large APIs stay small *@
            @if (node.Children.IsEmpty || (node.Kind == NavigationNode.NamespaceKind && !Navigation.IsInTrail(node)))
            {
                <li>@RenderLink(node)</li>
            }
            else
            {
                @* The disclosure toggle is separate from the link, so that interactive elements are not nested *@
                <li class="@(node.Kind == NavigationNode.ApiReferenceKind ? "nav-node nav-api-reference" : "nav-node")">
                    @RenderLink(node)
                    <details open="@(node.IsExpanded || Navigation.IsInTrail(node))">
                        <summary class="nav-toggle" aria-label="@($"{node.Title} section")"></summary>
                        @RenderTree(node.Children)
                    </details>
                </li>
            }
        }
    </ul>;

    private RenderFragment RenderLink(NavigationNode node) => node switch
    {
        { Url: null } => @<span class="nav-group">@node.Title</span>,
        { IsGroup: true } => @<a href="@node.Url" class="nav-group">@node.Title</a>,
        { IsExternal: true } => @<a href="@node.Url" class="nav-external" rel="noopener">@node.Title</a>,
        _ => @<a href="@node.Url" aria-current="@(Navigation.IsActive(node) ? "page" : null)">@node.Title</a>,
    };
}
