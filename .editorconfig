root = true

[*]
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

[*.{json,yml,yaml,xml,csproj,props,targets,slnx}]
indent_size = 2

[*.cs]
# Internal types are exercised by the test project through InternalsVisibleTo
dotnet_diagnostic.MA0182.severity = none
